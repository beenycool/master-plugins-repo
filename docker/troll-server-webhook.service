[Unit]
Description=Deploy webhook for the Guab plugin server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/troll-server/webhook.py
EnvironmentFile=/opt/troll-server/.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
