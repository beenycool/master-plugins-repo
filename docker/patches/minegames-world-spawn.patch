     private void enforceMobBarrier(){for(Runtime r:games.values()){World world=Bukkit.getWorld(r.station.worldName());if(world==null)continue;int h=r.station.size()/2+1;Location center=r.station.centerLocation();for(Entity entity:world.getNearbyEntities(center,h+1,32,h+1)){if(!(entity instanceof Mob mob)||fighter(mob)||!insideMobBarrier(r,mob.getLocation()))continue;mob.teleport(mobExit(r,mob.getLocation()));}}}private boolean insideMobBarrier(Runtime r,Location location){int h=r.station.size()/2+1;return Math.abs(location.getX()-(r.station.x()+.5))<h+.5&&Math.abs(location.getZ()-(r.station.z()+.5))<h+.5&&location.getY()>=r.station.y()-2;}private Location mobExit(Runtime r,Location from){double dx=from.getX()-(r.station.x()+.5),dz=from.getZ()-(r.station.z()+.5);int h=r.station.size()/2+1;double x=r.station.x()+.5,z=r.station.z()+.5;if(Math.abs(dx)>=Math.abs(dz))x+=Math.copySign(h+1.5,dx==0?1:dx);else z+=Math.copySign(h+1.5,dz==0?1:dz);return new Location(from.getWorld(),x,r.station.y()+1,z,from.getYaw(),from.getPitch());}private Mob opponent(Runtime r,Mob mob){return aliveFighters(r).stream().filter(m->m!=mob).min(Comparator.comparingDouble(m->m.getLocation().distanceSquared(mob.getLocation()))).orElse(null);} private List<Mob> aliveFighters(Runtime r){return r.fighters.stream().filter(m->m!=null&&m.isValid()&&!m.isDead()).toList();}
