     private ItemStack randomItem(Material[] materials){ItemStack item=new ItemStack(materials[ThreadLocalRandom.current().nextInt(materials.length)]);if(item.getItemMeta() instanceof LeatherArmorMeta leather){leather.setColor(Color.fromRGB(ThreadLocalRandom.current().nextInt(256),ThreadLocalRandom.current().nextInt(256),ThreadLocalRandom.current().nextInt(256)));item.setItemMeta(leather);}List<Enchantment> allowed=new ArrayList<>(Arrays.stream(Enchantment.values()).filter(enchantment->enchantment.canEnchantItem(item)).toList());int enchantments=1+ThreadLocalRandom.current().nextInt(3);Collections.shuffle(allowed);for(int i=0;i<Math.min(enchantments,allowed.size());i++){Enchantment enchantment=allowed.get(i);item.addUnsafeEnchantment(enchantment,1+ThreadLocalRandom.current().nextInt(Math.max(1,enchantment.getMaxLevel())));}return item;}
     private void combatWatchdog(){combatTick++;if(combatTick%5==0)enforceMobBarrier();for(Runtime r:games.values())if(r.phase==Phase.FIGHT){for(Mob mob:aliveFighters(r)){Mob target=opponent(r,mob);if(target==null)continue;if(mob.getTarget()!=target)mob.setTarget(target);ItemStack weapon=mob.getEquipment()==null?null:mob.getEquipment().getItemInMainHand();boolean ranged=isRanged(weapon);double distance=mob.getLocation().distanceSquared(target.getLocation());if(!ranged||distance>81.0)mob.getPathfinder().moveTo(target);if(combatTick>=r.nextAttackTick.getOrDefault(mob.getUniqueId(),0)&&distance<=(ranged?256.0:6.25)){if(ranged||mob.hasLineOfSight(target)){if(ranged)fireRangedProjectile(r,mob,target,weapon);else dealWeaponDamage(mob,target,weapon,false);r.nextAttackTick.put(mob.getUniqueId(),combatTick+attackCooldown(weapon,ranged));}}mob.setFireTicks(0);}}}private void moveFighter(Mob mob,Mob target,boolean ranged,double distanceSquared){org.bukkit.util.Vector direction=target.getLocation().toVector().subtract(mob.getLocation().toVector()).setY(0);if(direction.lengthSquared()<.01)return;direction.normalize();double speed=0;if(!ranged&&distanceSquared>3.24)speed=.28;else if(ranged&&distanceSquared>81)speed=.22;else if(ranged&&distanceSquared<36)speed=-.18;if(speed!=0)mob.setVelocity(direction.multiply(speed));Location facing=mob.getLocation();facing.setDirection(target.getEyeLocation().toVector().subtract(mob.getEyeLocation().toVector()));mob.setRotation(facing.getYaw(),facing.getPitch());}private boolean isRanged(ItemStack item){if(item==null)return false;return switch(item.getType()){case BOW,CROSSBOW,TRIDENT->true;default->false;};}private int attackCooldown(ItemStack item,boolean ranged){if(ranged)return item!=null&&item.getType()==Material.CROSSBOW?25:20;if(item==null)return 12;return switch(item.getType()){case WOODEN_AXE,STONE_AXE,IRON_AXE,GOLDEN_AXE,DIAMOND_AXE,NETHERITE_AXE,MACE->16;default->10;};}private void fireRangedProjectile(Runtime r,Mob attacker,Mob targ